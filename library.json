{
  "name": "SmartKey",
  "version": "2.2.0",
  "description": "Key and input event management for embedded systems: debounce, click / double / triple click, hold events, combos, sequences, value controllers and hardware scanners. Header-only, no dynamic allocation.",
  "keywords": "keypad, button, key, debounce, click, double-click, hold, combo, matrix, ir-remote, input, arduino, esp32",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nourbakhsh-Rad/SmartKey.git"
  },
  "authors": [
    {
      "name": "Sh. Nourbakhsh Rad",
      "email": "Sh.Nourbakhsh@gmail.com",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "frameworks": "*",
  "platforms": "*",
  "headers": "SmartKey.h",
  "examples": [
